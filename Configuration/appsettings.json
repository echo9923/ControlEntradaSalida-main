{
  // 服务基础配置
  "Service": {
    // gRPC 监听端口；需与防火墙/容器端口映射一致
    "GrpcListenPort": 5001,
    // 日志目录；建议使用具备写权限的绝对路径
    "LogDirectory": "C:\\Logs\\ControlEntradaSalida",
    // 日志保留天数；到期日志将被清理
    "LogRetentionDays": 90,
    // 是否启用超详细日志；开启后日志量显著增加，建议仅用于排查
    "VerboseLogging": false,
    // 是否记录 gRPC 请求与响应的 JSON 载荷
    "LogGrpcPayloads": false,
    // gRPC JSON 载荷日志最大字符数；超出部分将被截断
    "GrpcPayloadLogMaxChars": 2048,
    // 门禁管理接口 API Key；为空表示不强制鉴权（但会记录告警日志）
    "GrpcManagementApiKey": ""
  },
  // 数据库连接与执行策略
  "Database": {
    // SQL Server 连接字符串
    "ConnectionString": "Server=127.0.0.1,1433;Database=ruoyi-vue-pro;User Id=admin_user;Password=123456;TrustServerCertificate=True;",
    // 数据库命令超时时间（秒）
    "CommandTimeoutSeconds": 30
  },
  // 人脸事件入库与离线补偿配置
  "FaceEventLogging": {
    // 是否启用人脸事件入库
    "Enabled": true,
    // 抓拍图片根目录；为空则使用默认数据目录下的 snapshots 子目录
    // 支持绝对路径或相对路径（相对路径基于服务运行目录解析）
    "SnapshotRootDirectory": "",
    // 是否启用离线事件补偿
    "OfflineCompensationEnabled": true,
    // 事件处理队列容量（内存缓冲）
    "QueueCapacity": 2000,
    // 单批次写库条数
    "BatchSize": 20,
    // 写库失败重试间隔（秒）
    "RetryIntervalSeconds": 5,
    // 设备重连后补偿回溯窗口（分钟）
    "CompensationLookbackMinutes": 60,
    // 补偿期实时事件缓冲上限（每设备）
    "CompensationRealtimeBufferLimit": 2000,
    // 单次补偿最大持续时长（秒）
    "CompensationMaxDurationSeconds": 150,
    // 补偿缓冲溢出策略：DropOldest / DropNewest / FlushDirect
    "CompensationBufferOverflowPolicy": "FlushDirect",
    // 缓冲释放的单批次条数上限
    "CompensationReleaseBatchSize": 200,
    // 补偿完成后的尾补偿窗口（秒）
    "CompensationTailWindowSeconds": 10,
    // 报警布防类型：0-客户端布防（实时+离线），1-实时布防（仅实时）
    "AlarmDeployType": 0,
    // 排除的人脸事件设备 ID 列表（devices.device_id）
    "ExcludedDeviceIds": [],
    // 排除的人脸事件设备 IP 列表（忽略大小写与首尾空格）
    "ExcludedDeviceIps": ["192.168.1.105"]
  },
  // 设备连接与状态检查配置
  "DeviceConnection": {
    // 状态检查间隔（毫秒）
    "StatusCheckIntervalMs": 30000,
    // 状态检查获取设备 SDK 锁等待时间（毫秒）
    "StatusCheckSdkLockTimeoutMs": 1000,
    // 设备级 SDK 锁等待时间（毫秒）
    "DeviceSdkLockTimeoutMs": 30000,
    // 连接超时（毫秒）
    "ConnectTimeoutMs": 5000,
    // 断开连接超时（毫秒）
    "DisconnectTimeoutMs": 5000,
    // 最大并发连接/状态检查并发度
    "MaxConcurrentConnections": 10
  },
  // 断线重连策略
  "Reconnect": {
    // 最大重连尝试次数
    "MaxReconnectAttempts": 10,
    // 重连基准延迟（毫秒）
    "BaseDelayMs": 1000,
    // 重连最大延迟（毫秒）
    "MaxDelayMs": 300000,
    // 达到最大重连次数后的冷却期（毫秒）
    "PermanentFailureCooldownMs": 600000,
    // 重连检查间隔（毫秒）
    "ReconnectCheckIntervalMs": 5000
  }
,
  // ???????????
  "DeviceOperationRetry": {
    // ?????????????
    "Enabled": true,
    // ???????????????
    "ScanIntervalSeconds": 10,
    // ?????????????
    "RetryIntervalSeconds": 30,
    // ?????????????
    "MaxRetryAttempts": 20,
    // ????????????
    "FailureRetentionDays": 7
  }
}
