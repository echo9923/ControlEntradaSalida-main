<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>

  <connectionStrings>
    <clear />
  </connectionStrings>

  <appSettings>
    <!-- 运行时参数默认来源 Configuration\appsettings.json；此处可覆盖（优先级更高） -->
    <!-- 人脸补偿：实时事件缓冲上限（每设备），单位：条 -->
    <add key="FaceEventLogging.CompensationRealtimeBufferLimit" value="2000" />
    <!-- 人脸补偿：单次补偿最大持续时长，单位：秒 -->
    <add key="FaceEventLogging.CompensationMaxDurationSeconds" value="150" />
    <!-- 人脸补偿：缓冲溢出策略（DropOldest / DropNewest / FlushDirect） -->
    <add key="FaceEventLogging.CompensationBufferOverflowPolicy" value="FlushDirect" />
    <!-- 人脸补偿：缓冲释放单批次上限，单位：条 -->
    <add key="FaceEventLogging.CompensationReleaseBatchSize" value="200" />
    <!-- 人脸补偿：尾补偿窗口，单位：秒 -->
    <add key="FaceEventLogging.CompensationTailWindowSeconds" value="10" />
    <!-- 抓拍图片根目录；为空则使用默认数据目录下的 snapshots 子目录 -->
    <add key="FaceEventLogging.SnapshotRootDirectory" value="" />
    <!-- ?????????????????? -->
    <add key="DeviceOperationRetry.Enabled" value="true" />
    <!-- ????????????????????????? -->
    <add key="DeviceOperationRetry.ScanIntervalSeconds" value="10" />
    <!-- ??????????????????????? -->
    <add key="DeviceOperationRetry.RetryIntervalSeconds" value="30" />
    <!-- ??????????????????????? -->
    <add key="DeviceOperationRetry.MaxRetryAttempts" value="20" />
    <!-- ?????????????????????? -->
    <add key="DeviceOperationRetry.FailureRetentionDays" value="7" />
  </appSettings>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe"
                          publicKeyToken="b03f5f7f11d50a3a"
                          culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Memory"
                          publicKeyToken="cc7b13ffcd2ddd51"
                          culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.1.2" newVersion="4.0.1.2" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
