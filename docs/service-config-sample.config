<?xml version="1.0" encoding="utf-8"?>
<!-- 
  配置示例：将文件内容合并到实际 App.config 中即可。
  注意替换数据库连接与设备账户信息。
-->
<configuration>
  <configSections>
    <section name="deviceSettings"
             type="ControlEntradaSalida.Configuration.DeviceSettingsSection, ControlEntradaSalida" />
  </configSections>

  <connectionStrings>
    <clear />
    <add name="mysql"
         connectionString="server=数据库地址;user=账号;database=ruoyi-vue-pro;port=3306;password=安全密码"
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="GrpcListenPort" value="5001" />
    <add key="LogDirectory" value="D:\Logs\ControlEntradaSalida" />
    <add key="EnableSynchronizationDebugLog" value="false" />
    <add key="EnableDeviceConnectionDebugLog" value="false" />
  </appSettings>

  <deviceSettings>
    <devices>
      <device id="1"
              name="厂区东门"
              ipAddress="10.0.1.21"
              port="8000"
              username="hik-user"
              password="secure-password"
              enabled="true" />
      <device id="2"
              name="厂区西门"
              ipAddress="10.0.1.22"
              port="8000"
              username="hik-user"
              password="secure-password"
              enabled="true" />
    </devices>
  </deviceSettings>
</configuration>
